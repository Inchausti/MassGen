# Copie para .env e ajuste. O .env não vai para o Git.

# Porta do app local
PORT=3000

# Endereço de escuta. Vazio (padrão): todas as interfaces da máquina.
# Hospedado atrás do Cloudflare Tunnel, use 127.0.0.1: só o cloudflared, na mesma máquina, alcança o app.
MASSGEN_HOST=

# Usuários root, separados por vírgula. Na subida, quem ainda não tem senha recebe no console
# (journalctl -u massgen, na VM) um link de primeiro acesso, válido por 24 h. Os demais entram por convite de um root.
MASSGEN_ROOTS=voce@empresa.com.br

# Endereço pelo qual o time abre o app. Monta os links de primeiro acesso e de convite.
# É o único lugar com o domínio: o README tira dele o hostname do túnel.
# Vazio: http://localhost:<PORT>. Hospedado: https://<seu domínio>, por exemplo https://massgen.split.com
MASSGEN_URL_PUBLICA=

# Cookie de sessão só por HTTPS. Vazio: liga sozinho quando MASSGEN_URL_PUBLICA começa com https://
MASSGEN_COOKIE_SEGURO=

# Duração da sessão, em horas
MASSGEN_SESSAO_HORAS=12

# Camada opcional: true só com o app atrás do Cloudflare Access e em 127.0.0.1. Aí o e-mail autenticado pelo Access
# (cabeçalho Cf-Access-Authenticated-User-Email) entra sem senha, desde que esteja cadastrado no MassGen.
# Sem o Access na frente, deixe false: o cabeçalho poderia ser forjado.
MASSGEN_CONFIAR_CLOUDFLARE_ACCESS=false

# Pasta do banco SQLite e da chave do cofre
MASSGEN_DATA_DIR=data

# Trava de produção: só estes domínios podem ser destino, separados por vírgula.
# Aceita curinga no começo: *.sandbox.exemplo.com
ALLOWED_DESTINATION_DOMAINS=localhost,127.0.0.1

# Domínios sempre recusados, mesmo que estejam na lista acima
BLOCKED_DESTINATION_DOMAINS=

# Chave mestra do cofre (32 bytes em base64). Se ficar vazia, o app cria uma em data/master.key
MASSGEN_MASTER_KEY=
