# Cloudflare Tunnel do MassGen, criado no painel do Cloudflare. Instalado por deploy/instalar.sh (--tunel painel).
# O hostname público é configurado no painel, no túnel: o domínio de MASSGEN_URL_PUBLICA apontando para o serviço
# HTTP 127.0.0.1:3000.
# O token fica em /etc/cloudflared/massgen-tunel.env (TUNNEL_TOKEN=..., só o root lê), e não na linha de comando
# como no "cloudflared service install <token>": assim ele não aparece no ps nem no systemctl cat.

[Unit]
Description=MassGen - Cloudflare Tunnel (painel)
Documentation=https://github.com/Inchausti/MassGen
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=0
EnvironmentFile=/etc/cloudflared/massgen-tunel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5s

# O túnel do painel não lê nem grava arquivo nenhum: roda com um usuário descartável e o disco só para leitura.
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
