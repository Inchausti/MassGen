{
  "name": "massgen",
  "version": "0.1.0",
  "private": true,
  "description": "Gerador de massa de dados genérico: modela entidades, gera massa coerente, envia a APIs de destino, acompanha cada requisição e confere o resultado.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node server/main.ts",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "mock": "node mock/servidor.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "jsonata": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
